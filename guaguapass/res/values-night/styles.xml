<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modo nocturno (API 24+): tema Material "full dark" + paleta oscura de
         values-night/colors.xml. Sustituye al antiguo values-v29 que usaba
         @android:style/Theme.DeviceDefault.DayNight.NoActionBar, estilo que no
         existe en el android.jar publicable y rompía el link de aapt2. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primaryDark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primaryDark</item>
        <item name="android:navigationBarColor">@color/primaryDark</item>
        <item name="android:windowAnimationStyle">@style/WindowFade</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>
</resources>
